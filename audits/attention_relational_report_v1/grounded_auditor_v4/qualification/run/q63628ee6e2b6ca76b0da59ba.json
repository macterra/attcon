            "text": "{\"assertions\":[{\"assertion_id\":\"a1\",\"paraphrase\":\"The statement is about panel p0, view current, node n1.\",\"reason\":\"c0009/c0006/c0007/c0008/c0001 supply a relation and role distributions explicitly for node n1 in panel p0 view current, so the report's location label follows from the record.\",\"source_context_ids\":[\"c0009\",\"c0006\",\"c0007\",\"c0008\",\"c0001\"],\"span_ids\":[\"s0001\"],\"verdict\":\"supported\"},{\"assertion_id\":\"a2\",\"paraphrase\":\"At p0/current/n1, the red\u2013blue peak relation includes the vertical relation 'above'.\",\"reason\":\"c0009 (red_blue_peak_relation for p0/current/n1) lists vertical:[\\\"above\\\",\\\"below\\\"], so 'above' is included.\",\"source_context_ids\":[\"c0009\",\"c0007\",\"c0008\",\"c0006\",\"c0001\"],\"span_ids\":[\"s0001\"],\"verdict\":\"supported\"},{\"assertion_id\":\"a3\",\"paraphrase\":\"At p0/current/n1, the red\u2013blue peak relation includes the vertical relation 'below'.\",\"reason\":\"c0009 (red_blue_peak_relation for p0/current/n1) lists vertical:[\\\"above\\\",\\\"below\\\"], so 'below' is included.\",\"source_context_ids\":[\"c0009\",\"c0007\",\"c0008\",\"c0006\",\"c0001\"],\"span_ids\":[\"s0001\"],\"verdict\":\"supported\"},{\"assertion_id\":\"a4\",\"paraphrase\":\"At p0/current/n1, every red peak is left of every blue peak.\",\"reason\":\"c0009 reports horizontal:[\\\"left_of\\\"] for p0/current/n1 and the supplied role distributions c0007 (red peaks [[0,0],[2,0]]) and c0008 (blue peaks [[1,3]]) place red columns left of the blue column, so the universal left_of claim follows from the supplied contexts.\",\"source_context_ids\":[\"c0009\",\"c0007\",\"c0008\",\"c0006\",\"c0001\"],\"span_ids\":[\"s0002\"],\"verdict\":\"supported\"}],\"complete_assertion_inventory\":true,\"coverage\":[{\"assertion_ids\":[],\"classification\":\"nonassertive\",\"reason\":\"Span is a heading/label with no substantive factual claim.\",\"span_id\":\"s0000\"},{\"assertion_ids\":[\"a1\",\"a2\",\"a3\"],\"classification\":\"assertive\",\"reason\":\"Span asserts location (p0/current/n1) and that the red\u2013blue relation includes 'above' and 'below'; supported by contexts c0009 plus the node/view distributions/origin (c0006,c0007,c0008) and panel metadata c0001.\",\"span_id\":\"s0001\"},{\"assertion_ids\":[\"a4\"],\"classification\":\"assertive\",\"reason\":\"Span asserts a universal horizontal relation (every red peak left_of every blue peak); supported by c0009 and the red/blue distributions c0007 and c0008 showing red columns left of blue.\",\"span_id\":\"s0002\"}],\"schema\":\"attention_relational_grounded_auditor_v4_annotation\",\"unit_id\":\"b5720fdc604b0a4ed49e1138\",\"unresolved_ambiguity\":false}",
