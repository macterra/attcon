ssertion_ids\":[\"a3\"],\"classification\":\"assertive\",\"reason\":\"Span asserts universal left_of relation; supported by relation and operand distributions (c0009,c0007,c0008,c0006,c0001).\",\"span_id\":\"s0002\"}],\"schema\":\"attention_relational_grounded_auditor_v4_annotation\",\"unit_id\":\"3a4169b0b4257b345f3d47d3\",\"unresolved_ambiguity\":false}",
